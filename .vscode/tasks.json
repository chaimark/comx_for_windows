{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "构建全部 (Debug)",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/d",
                "/c",
                "buildCom.cmd DEBUG=1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
